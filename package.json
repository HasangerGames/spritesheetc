{
  "name": "spritesheetc",
  "version": "1.0.0",
  "description": "Ridiculously fast spritesheet generator written in C++.",
  "main": "index.js",
  "bin": "spritesheetc.js",
  "scripts": {
    "install": "pkg-prebuilds-verify ./binding-options.js || cmake-js compile",
    "copyPrebuilds": "pkg-prebuilds-copy --baseDir build/Release --source spritesheetc.node --name=spritesheetc --strip --napi_version=8"
  },
  "keywords": [
    "c++",
    "spritesheet",
    "texturepacker",
    "svg",
    "resvg"
  ],
  "author": "Henry Sanger",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.11.0",
  "binary": {
    "napi_versions": [
      8
    ]
  },
  "dependencies": {
    "@types/node": "^25.0.9",
    "cmake-js": "^7.4.0",
    "node-addon-api": "^8.5.0",
    "pkg-prebuilds": "^1.0.0"
  }
}
